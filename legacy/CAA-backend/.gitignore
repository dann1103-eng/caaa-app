# Ignorar el archivo de variables de entorno (todas las variantes)
.env
.env.*
!.env.example

# Ignorar la carpeta de node_modules (dependencias)
node_modules/

# Subidas de usuarios y archivos temporales
uploads/
temp.js

# Datos reales / PII / utilitarios de carga de una sola vez (NO commitear)
_roster.json
_credenciales_carga.csv
seed_alumnos_reales.js

# Otras configuraciones de sistemas operativos (opcional)
.DS_Store
# Scripts de verificacion E2E de una sesion. La convencion (CLAUDE.md §20.H) ya
# decia "nombre con guion bajo = ignorar en git", pero solo estaban listados dos
# archivos sueltos. Viven aca y no en el scratchpad porque necesitan resolver
# dotenv y pg desde node_modules, y require() resuelve contra la carpeta DEL
# SCRIPT, no contra el cwd.
_*.js
_*.sql
